# این فایل را به .env تغییر نام بده و کلیدت را بگذار
# Rename this file to .env and add your key

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# مدل بزرگ — فقط برای تولید جواب نهایی
# Large model — only for final answer generation
GEN_MODEL=moonshotai/kimi-k3

# اگر مدل اصلی خطا داد، به ترتیب می‌رود سراغ اینها
# Failover chain if the primary model fails
GEN_FALLBACKS=openai/gpt-oss-120b,minimaxai/minimax-m3

# مدل کوچک و سریع — برای مستقل‌سازی، داوری، بازنویسی
# Small fast model — for contextualize, grade, rewrite
FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
FAST_FALLBACKS=google/diffusiongemma-26b-a4b-it

# امبدینگ لوکال چندزبانه
# Local multilingual embedding
EMBED_MODEL=BAAI/bge-m3
